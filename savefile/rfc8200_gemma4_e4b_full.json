      "helper_functions": [
        {
          "name": "calculate_pseudo_header_length",
          "description": "Used for calculating the Upper-Layer Packet Length in the pseudo-header (e.g., TCP/UDP). If the upper-layer protocol provides its own length field, use that; otherwise, use the IPv6 Payload Length minus the length of any extension headers present between the IPv6 header and the upper-layer header."
        }
      ],
      "transform_functions": [
        {
          "name": "reassemble_fragment_packet",
          "from": "Fragment packet",
          "to": "Reassembled original packet",
          "description": "Performs reassembly using matching Source Address, Destination Address, and Fragment Identification. Computes the reassembled Payload Length using the formula: PL.orig = PL.first - FL.first - 8 + (8 * FO.last) + FL.last. The Fragment header is removed."
        }
